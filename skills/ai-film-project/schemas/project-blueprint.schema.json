{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dex/ai-film-grok/project-blueprint.schema.json",
  "title": "ai-film-grok Project Blueprint",
  "type": "object",
  "required": ["schema_version", "kind", "project", "story", "characters", "style", "continuity", "episodes", "handoff"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ai-film-project-blueprint"},
    "project": {"type": "object", "required": ["project_id", "title", "format", "status"], "properties": {"project_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"}, "title": {"type": "string", "minLength": 1}, "format": {"enum": ["vertical_9_16", "horizontal_16_9", "square_1_1", "custom"]}, "status": {"enum": ["staged", "review", "approved", "stale"]}, "lock_hash": {"type": "string"}}},
    "story": {"type": "object", "required": ["source", "source_sha256", "status"], "properties": {"source": {"type": "string", "minLength": 1}, "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"enum": ["staged", "review", "approved", "stale"]}, "user_facts": {"type": "array", "items": {"type": "string"}}, "unknowns": {"type": "array", "items": {"type": "string"}}}},
    "characters": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["character_id", "name", "reference_views", "canonical_master", "status"], "properties": {"character_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"}, "name": {"type": "string", "minLength": 1}, "aliases": {"type": "array", "items": {"type": "string"}}, "reference_views": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["view_id", "role", "path", "sha256"], "properties": {"view_id": {"type": "string"}, "role": {"enum": ["front", "side", "back", "three_quarter", "expression", "wardrobe_state", "other"]}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "review_status": {"enum": ["needs_review", "approved"]}}}}, "canonical_master": {"type": "object", "required": ["view_id", "path", "sha256", "review_status"], "properties": {"view_id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "review_status": {"enum": ["needs_review", "approved"]}}}, "identity_lock_tokens": {"type": "array", "items": {"type": "string"}}, "never_tokens": {"type": "array", "items": {"type": "string"}}, "hair_lock": {"type": "string"}, "makeup_lock": {"type": "string"}, "wardrobe_lock": {"type": "string"}, "status": {"enum": ["staged", "review", "approved", "stale"]}}}},
    "style": {"type": "object", "required": ["medium", "palette", "lighting", "rendering", "signature_block", "negative_constraints", "status"], "properties": {"medium": {"type": "string", "minLength": 1}, "palette": {"type": "string", "minLength": 1}, "lighting": {"type": "string", "minLength": 1}, "lens": {"type": "string"}, "rendering": {"type": "string", "minLength": 1}, "signature_block": {"type": "string", "minLength": 48}, "negative_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "style_sample": {"type": "object"}, "status": {"enum": ["staged", "review", "approved", "stale"]}}},
    "continuity": {"type": "object", "required": ["stable_id_policy", "state_policy", "continue_policy"], "properties": {"stable_id_policy": {"type": "string", "minLength": 1}, "state_policy": {"type": "string", "minLength": 1}, "continue_policy": {"type": "string", "minLength": 1}, "required_receipts": {"type": "array", "items": {"type": "string"}}}},
    "episodes": {"type": "array", "items": {"type": "object", "required": ["episode_id", "status"], "properties": {"episode_id": {"type": "string"}, "previous_episode_id": {"type": ["string", "null"]}, "story_change": {"type": "string"}, "status": {"enum": ["planned", "in_progress", "locked", "stale"]}, "state_changes": {"type": "array", "items": {"type": "string"}}}}},
    "handoff": {"type": "object", "required": ["project_lock_fields", "episode_fields", "approval_required"], "properties": {"project_lock_fields": {"type": "array", "items": {"type": "string"}}, "episode_fields": {"type": "array", "items": {"type": "string"}}, "approval_required": {"type": "array", "items": {"type": "string"}}}}
  }
}
