#!/bin/sh
set -eu

case "${1:-}" in
  -h|--help)
    printf '%s\n' 'Usage: test-skill' 'Run the complete offline ai-film-grok test suite.'
    exit 0
    ;;
esac

SKILL_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ -n "${AIFILM_PYTHON:-}" ] && [ -x "${AIFILM_PYTHON}" ]; then
  PYTHON=${AIFILM_PYTHON}
elif command -v pyenv >/dev/null 2>&1; then
  PYTHON=$(pyenv which python3)
elif [ -x "${HOME}/.pyenv/versions/3.11.15/bin/python3" ]; then
  PYTHON=${HOME}/.pyenv/versions/3.11.15/bin/python3
else
  PYTHON=$(command -v python3)
fi

cd "$SKILL_DIR"
exec "$PYTHON" -m unittest discover -s tests -v
