# Copy to C:\aifilm-lipsync-node\node.env and replace every CHANGE_ME value.
AIFILM_LIPSYNC_NODE_TOKEN=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS
AIFILM_LIPSYNC_NODE_HOST=127.0.0.1
AIFILM_LIPSYNC_NODE_PORT=8790
AIFILM_LIPSYNC_NODE_ROOT=C:\aifilm-lipsync-node\jobs
AIFILM_LIPSYNC_NODE_TIMEOUT=1800
AIFILM_LIPSYNC_NODE_LATENTSYNC_MODEL=ByteDance/LatentSync-1.6
AIFILM_LIPSYNC_NODE_LATENTSYNC_APPROVED=0
AIFILM_LIPSYNC_NODE_LATENTSYNC_CHECKPOINT_SHA256=CHANGE_ME
AIFILM_LIPSYNC_NODE_LATENTSYNC_REPO_COMMIT=CHANGE_ME
AIFILM_LIPSYNC_NODE_LATENTSYNC_ARGV=["wsl.exe","-d","Ubuntu","--user","user","--","/usr/bin/timeout","--kill-after=10s","1750s","/home/user/lipsync-envs/latentsync/bin/python","/mnt/c/aifilm-lipsync-node/adapters/latentsync_adapter.py","--video","{video_wsl}","--audio","{audio_wsl}","--out","{out_wsl}","--inference-steps","{inference_steps}","--guidance-scale","{guidance_scale}","--deepcache","{deepcache}"]
AIFILM_LIPSYNC_NODE_LATENTSYNC_PROBE_ARGV=["wsl.exe","-d","Ubuntu","--user","user","--","/usr/bin/timeout","300s","/home/user/lipsync-envs/latentsync/bin/python","/mnt/c/aifilm-lipsync-node/adapters/backend_probe.py","--root","/home/user/LatentSync","--checkpoint","/home/user/LatentSync/checkpoints/latentsync_unet.pt","--adapter","/mnt/c/aifilm-lipsync-node/adapters/latentsync_adapter.py"]
# Do not configure MuseTalk readiness until its clean checkout and canary are approved.
AIFILM_LIPSYNC_NODE_MUSETALK_MODEL=MuseTalk-1.5
AIFILM_LIPSYNC_NODE_MUSETALK_APPROVED=0
AIFILM_LIPSYNC_NODE_MUSETALK_CHECKPOINT_SHA256=
AIFILM_LIPSYNC_NODE_MUSETALK_REPO_COMMIT=
AIFILM_LIPSYNC_NODE_MUSETALK_ARGV=
AIFILM_LIPSYNC_NODE_MUSETALK_PROBE_ARGV=
