# ai-film-grok local config template
# Copy to config.env and chmod 600. Never commit config.env.

# --- TTS ---
# auto | edge | fish | minimax | voicebox | external | grok
# 中文成片推荐 edge（Neural 声线）；勿把 zh-CN-*Neural 塞进 ElevenLabs
# SuperGrok 升档（opt-in，永不 auto）：AIFILM_TTS_BACKEND=grok + OAuth
# 本机装了 Voicebox 且锁了 profile：可 voicebox 或 auto（本地优先）
AIFILM_TTS_BACKEND=edge
AIFILM_TTS_STRICT_VOICE=1
# 显式 edge/minimax/fish 失败时，再试本地 Voicebox 一次（默认关；质量/兜底 opt-in）
# AIFILM_TTS_VOICEBOX_FALLBACK=0
# 开: AIFILM_TTS_VOICEBOX_FALLBACK=1  （须 App 就绪 + VOICEBOX_PROFILE）

# Fish Audio (optional)
# FISH_API_KEY=
# FISH_VOICE_ID=
# FISH_MODEL=s2.1-pro-free

# MiniMax (optional)
# MINIMAX_API_KEY=
# MINIMAX_VOICE_ID=
# MINIMAX_MODEL=
# MINIMAX_GROUP_ID=

# --- Voicebox local studio (optional; https://github.com/jamiepine/voicebox) ---
# 默认量产仍 edge。Voicebox = 质量升级 / 克隆声 / 失败 opt-in 兜底（非默认替换 edge）。
# 1) 启动 App 或 docker  →  2) 建固定 profile  →  3) doctor / capability 绿
# VOICEBOX_BASE_URL=http://127.0.0.1:17493
# VOICEBOX_PROFILE=my-storyteller   # name or id；一角一声锁定（勿填 zh-CN-*Neural）
# VOICEBOX_LANGUAGE=zh
# VOICEBOX_ENGINE=qwen              # 中文建议 qwen；可选 kokoro|chatterbox|...
# film-spec: "tts_backend": "voicebox", "vo_voice": "my-storyteller"
# 试听对照: aifilm tts-ab --root <film> --shot shot01 --backends edge,voicebox
# 机位一页: aifilm capability  ·  aifilm capability --root <film> --suggest-i2v

# External TTS via argv JSON (no shell). Placeholders: {text_file} {out} {voice}
# AIFILM_TTS_ARGV=["python3","/path/to/adapters/elevenlabs_tts.py","--text-file","{text_file}","--out","{out}","--voice","{voice}"]
# Voicebox via external argv (optional; first-class backend preferred):
# AIFILM_TTS_ARGV=["python3","$HOME/.grok/skills/ai-film-grok/scripts/adapters/voicebox_tts.py","--text-file","{text_file}","--out","{out}","--voice","{voice}"]

# --- ElevenLabs (if using external adapter) ---
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Lip-sync (optional; off by default) ---
AIFILM_LIPSYNC_BACKEND=off
# AIFILM_WAV2LIP_ROOT=
# AIFILM_MUSETALK_ROOT=

# --- Grok auth: OAuth pack (grok login → ~/.grok/auth.json) preferred ---
# auto | oauth | api_key
AIFILM_GROK_AUTH=auto
# AIFILM_GROK_AUTH_PATH=~/.grok/auth.json
# AIFILM_GROK_API_BASE=https://api.x.ai/v1
# AIFILM_GROK_CHAT_MODEL=grok-4.5
# AIFILM_GROK_IMAGE_MODEL=grok-imagine-image
# AIFILM_GROK_VIDEO_MODEL=grok-imagine-video
# AIFILM_GROK_TTS_VOICE=eve
# AIFILM_GROK_TTS_LANGUAGE=zh
# AIFILM_GROK_PROBE_TTS=1   # doctor deep TTS list
# CI fallback only:
# XAI_API_KEY=
# CLI pack: doctor|chat|image|image-edit|video|tts|voices
# See: aifilm grok-oauth doctor --deep · references/grok-oauth.md
# --- I2V operating profile ---
# grok_primary = Seedance off → bulk image_to_video (current)
# seedance_first = FRW Seedance bulk when canary 201
AIFILM_I2V_PROFILE=grok_primary
AIFILM_SEEDANCE_AVAILABLE=0
# Restore: AIFILM_I2V_PROFILE=seedance_first + AIFILM_SEEDANCE_AVAILABLE=1
