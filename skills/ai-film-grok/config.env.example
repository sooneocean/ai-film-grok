# ai-film-grok local config template
# Copy to config.env and chmod 600. Never commit config.env.

# --- TTS ---
# audio_node | mimo | auto | edge | fish | minimax | voicebox | external | cosyvoice-local | grok | qwen3 | higgs
# 中文成片默认 private 5090 Qwen3-TTS；节点不可用时会明确失败，不静默改用其他声线
# SuperGrok 升档（opt-in，永不 auto）：AIFILM_TTS_BACKEND=grok + OAuth
# 本机装了 Voicebox 且锁了 profile：可 voicebox 或 auto（本地优先）
AIFILM_TTS_BACKEND=audio_node
AIFILM_TTS_STRICT_VOICE=1
# Xiaomi MiMo TTS（OpenAI-compatible；预设声线：冰糖/茉莉/苏打/白桦）
# MIMO_API_KEY=                 # 在 MiMo 控制台重建后填入；绝不提交
# MIMO_API_BASE=https://api.xiaomimimo.com/v1
# MIMO_TTS_MODEL=mimo-v2.5-tts
# MIMO_TTS_VOICE=冰糖           # 每部影片固定一把声线；中文女声
# MIMO_TTS_STYLE=自然、电影感的中文旁白；保持原文，不改写。
# VoiceDesign：MIMO_TTS_MODEL=mimo-v2.5-tts-voicedesign（不传 MIMO_TTS_VOICE）
# VoiceClone：MIMO_TTS_MODEL=mimo-v2.5-tts-voiceclone + 下列本机授权参考音频
# MIMO_TTS_REFERENCE_AUDIO=/absolute/path/licensed-reference.wav  # MP3/WAV，≤7.5MB
# Qwen3-TTS: install qwen-tts/torch/soundfile, then use film-spec tts_backend=qwen3
# QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# QWEN3_TTS_REF_AUDIO=/absolute/path/clean-reference.wav
# QWEN3_TTS_REF_TEXT=
# QWEN3_TTS_DEVICE=auto
# Higgs Audio: provide a trusted JSON argv inference command; never auto-selected
# HIGGS_AUDIO_MODEL=bosonai/higgs-audio-v2.5
# HIGGS_AUDIO_ARGV=["python3","/trusted/higgs_adapter.py","--text-file","{text_file}","--out","{out}","--performance-file","{performance_file}"]
# 显式 edge/minimax/fish 失败时，再试本地 Voicebox 一次（默认关；质量/兜底 opt-in）
# AIFILM_TTS_VOICEBOX_FALLBACK=0
# Private 5090 node: explicit opt-in; quality fallback remains auditable.
# Keep the Windows service on 127.0.0.1:8788 and tunnel it to this Mac endpoint:
# ssh -N -L 18788:127.0.0.1:8788 user@<private-5090-ip>
# AIFILM_AUDIO_NODE_URL=http://127.0.0.1:18788
# AIFILM_AUDIO_NODE_TOKEN=
# AIFILM_BGM_LIBRARY_ROOT=~/.grok/ai-film-grok/bgm-library
# AIFILM_SFX_LIBRARY_ROOT=~/AI FILM SPACE/audio-armory
# Windows node (trusted JSON argv; prompt stays in an ephemeral local request file):
# AIFILM_AUDIO_NODE_MUSIC_BATCH_ARGV=["python","C:\\aifilm-audio-node\\ace_step_music.py","--request-json","{request_json}","--out-dir","{out_dir}"]
# AIFILM_AUDIO_NODE_MUSIC_MODEL=ACE-Step-1.5
# AIFILM_AUDIO_NODE_MUSIC_CHECKPOINT_FINGERPRINT=
# Stable Audio Open is candidate-only. Keep the local snapshot/checkpoint and
# adapter hashes aligned with the probe; do not mark its output production-ready.
# AIFILM_AUDIO_NODE_AMBIENT_MODEL=stabilityai/stable-audio-open-1.0
# AIFILM_AUDIO_NODE_AMBIENT_LICENSE=Stability AI Community License
# AIFILM_AUDIO_NODE_AMBIENT_CHECKPOINT_SHA256=
# AIFILM_AUDIO_NODE_AMBIENT_ADAPTER_SHA256=
# AIFILM_AUDIO_NODE_AMBIENT_PROBE_ARGV=["python","C:\\aifilm-audio-node\\stable_audio_probe.py","--model-root","C:\\AI_Models\\stable-audio-open-1.0","--checkpoint","C:\\AI_Models\\stable-audio-open-1.0\\model.safetensors","--adapter","C:\\aifilm-audio-node\\stable_audio_adapter.py","--model","stabilityai/stable-audio-open-1.0","--license","Stability AI Community License"]
# AIFILM_AUDIO_NODE_AMBIENT_ARGV=["python","C:\\aifilm-audio-node\\stable_audio_adapter.py","--model-root","C:\\AI_Models\\stable-audio-open-1.0","--checkpoint","C:\\AI_Models\\stable-audio-open-1.0\\model.safetensors","--expected-checkpoint-sha256","<same checkpoint SHA-256>","--expected-adapter-sha256","<same adapter SHA-256>","--prompt","{prompt}","--duration","{duration}","--seed","{seed}","--out","{out}"]
# 开: AIFILM_TTS_VOICEBOX_FALLBACK=1  （须 App 就绪 + VOICEBOX_PROFILE）

# Private 5090 semantic index (opt-in; local authoring text only, never story truth or approval).
# AIFILM_LOCAL_EMBEDDING_BASE_URL=http://192.168.88.52:1234/v1
# AIFILM_LOCAL_EMBEDDING_TOKEN=
# aifilm semantic-index build --root <film>
# aifilm semantic-index query --root <film> --query "红夹克快递员"

# Fish Audio (optional)
# FISH_API_KEY=
# FISH_VOICE_ID=
# FISH_MODEL=s2.1-pro-free

# MiniMax (optional)
# MINIMAX_API_KEY=
# MINIMAX_VOICE_ID=
# MINIMAX_MODEL=
# MINIMAX_GROUP_ID=

# --- Voicebox local studio (optional; https://github.com/jamiepine/voicebox) ---
# 默认量产仍 edge。Voicebox = 质量升级 / 克隆声 / 失败 opt-in 兜底（非默认替换 edge）。
# 1) 启动 App 或 docker  →  2) 建固定 profile  →  3) doctor / capability 绿
# VOICEBOX_BASE_URL=http://127.0.0.1:17493
# VOICEBOX_PROFILE=my-storyteller   # name or id；一角一声锁定（勿填 zh-CN-*Neural）
# VOICEBOX_LANGUAGE=zh
# VOICEBOX_ENGINE=qwen              # 中文建议 qwen；可选 kokoro|chatterbox|...
# film-spec: "tts_backend": "voicebox", "vo_voice": "my-storyteller"
# 试听对照: aifilm tts-ab --root <film> --shot shot01 --backends edge,voicebox
# 机位一页: aifilm capability  ·  aifilm capability --root <film> --suggest-i2v

# External TTS via argv JSON (no shell). Placeholders: {text_file} {out} {voice}
# AIFILM_TTS_ARGV=["python3","/path/to/adapters/elevenlabs_tts.py","--text-file","{text_file}","--out","{out}","--voice","{voice}"]
# Local CosyVoice (explicit only; keeps the MiMo default).  Use a licensed reference
# and its exact transcript; never use a cloned voice without authorization.
# COSYVOICE_ROOT=/Users/dex/Developer/CosyVoice
# COSYVOICE_MODEL_DIR=/Users/dex/Developer/CosyVoice/pretrained_models/Fun-CosyVoice3-0.5B-hf
# COSYVOICE_REF_WAV=/absolute/path/licensed-reference.wav
# COSYVOICE_PROMPT_TEXT=exact transcript of the licensed reference
# AIFILM_TTS_ARGV=["/opt/homebrew/Caskroom/miniforge/base/envs/aifilm-cosyvoice/bin/python3","/Users/dex/.grok/plugins/ai-film-grok/skills/ai-film-grok/scripts/adapters/cosyvoice_local_tts.py","--text-file","{text_file}","--out","{out}","--voice","{voice}"]
# film-spec: "tts_backend": "cosyvoice-local", "vo_voice": "cosyvoice-narrator"
# Voicebox via external argv (optional; first-class backend preferred):
# AIFILM_TTS_ARGV=["python3","$HOME/.grok/skills/ai-film-grok/scripts/adapters/voicebox_tts.py","--text-file","{text_file}","--out","{out}","--voice","{voice}"]
# DEPRECATED (disabled): AIFILM_TTS_CMD — shell templates are unsafe; use AIFILM_TTS_ARGV JSON argv instead.

# Local VibeVoice-ASR final-audio QA (optional, pilot-only; never a TTS backend).
# The official VibeVoice checkout/model must already be installed on the selected host.
# AIFILM_VIBEVOICE_ASR_ARGV=["/path/to/vibevoice-venv/bin/python","/Users/dex/.grok/plugins/ai-film-grok/skills/ai-film-grok/scripts/adapters/vibevoice_asr.py","--audio","{audio}","--out","{out}","--model-path","/path/to/VibeVoice-ASR","--device","cuda"]
# Remote 5090 bridge (optional): stages one input and returns only a candidate transcript JSON.
# AIFILM_VIBEVOICE_ASR_ARGV=["/path/to/pinned-python3","/Users/dex/.grok/plugins/ai-film-grok/skills/ai-film-grok/scripts/adapters/vibevoice_asr_ssh.py","--audio","{audio}","--out","{out}"]
# AIFILM_VIBEVOICE_ASR_SSH_TARGET=user@192.168.30.36
# AIFILM_VIBEVOICE_ASR_SSH_KEY=/Users/dex/.ssh/aifilm_5090_ed25519
# AIFILM_VIBEVOICE_ASR_SSH_HOSTKEY_ALIAS=192.168.88.52
# AIFILM_VIBEVOICE_ASR_REMOTE_ROOT=C:\\aifilm-vibevoice
# AIFILM_VIBEVOICE_ASR_REMOTE_MODEL_PATH=C:\\AI_Models\\VibeVoice-ASR

# --- Hugging Face Speech-to-Speech preview sidecar (experimental; never a final TTS backend) ---
# Keep the server private: it has no authentication or throttling. Bind it to 127.0.0.1
# on the 5090 and reach it through an SSH tunnel. The launcher/guard are JSON argv only.
# AIFILM_SPEECH_PREVIEW_URL=http://127.0.0.1:8765
# AIFILM_SPEECH_PREVIEW_GUARD_ARGV=["/trusted/python3","/trusted/speech_preview_guard.py"]
# Guard stdout must be JSON: {"queue_idle":true,"free_vram_mib":24576,"free_ram_mib":12288,"python_version":"3.11","cuda":"13.x"}
# AIFILM_SPEECH_PREVIEW_START_ARGV=["ssh","...","speech-to-speech","--ws_host","127.0.0.1","--ws_port","8765","--stt","whisper","--stt_model_name","large-v3","--tts","qwen3","--llm_backend","responses-api"]
# Pin: speech-to-speech==0.2.11; Qwen3-TTS CustomVoice; Qwen3-4B-Instruct-2507 Q4_K_M via local llama.cpp.
# Do not add --enable_llm_proxy. `aifilm speech-preview probe` starts nothing.

# --- ElevenLabs (if using external adapter) ---
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Lip-sync (optional; off by default) ---
AIFILM_LIPSYNC_BACKEND=off
# Private Windows RTX 5090 node. Keep the token only in config.env.
# Default production transport is an SSH tunnel:
# ssh -N -L 18790:127.0.0.1:8790 user@192.168.88.52
# AIFILM_LIPSYNC_NODE_BASE_URL=http://127.0.0.1:18790
# AIFILM_LIPSYNC_NODE_TOKEN=
# AIFILM_LIPSYNC_FALLBACK=
# AIFILM_WAV2LIP_ROOT=
# AIFILM_LIPSYNC_ARGV=["python3","/path/to/lipsync.py","--in","{in}","--out","{out}"]
# DEPRECATED (disabled): AIFILM_LIPSYNC_CMD — shell templates are unsafe; use AIFILM_LIPSYNC_ARGV JSON argv instead.

# --- Grok auth: OAuth pack (grok login → ~/.grok/auth.json) preferred ---
# auto | oauth | api_key
AIFILM_GROK_AUTH=auto
# AIFILM_GROK_AUTH_PATH=~/.grok/auth.json
# AIFILM_GROK_API_BASE=https://api.x.ai/v1
# AIFILM_GROK_CHAT_MODEL=grok-4.5
# AIFILM_GROK_IMAGE_MODEL=grok-imagine-image
# AIFILM_GROK_VIDEO_MODEL=grok-imagine-video
# AIFILM_GROK_TTS_VOICE=eve
# AIFILM_GROK_TTS_LANGUAGE=zh
# AIFILM_GROK_PROBE_TTS=1   # doctor deep TTS list
# CI fallback only:
# XAI_API_KEY=
# CLI pack: doctor|chat|image|image-edit|video|tts|voices
# See: aifilm grok-oauth doctor --deep · references/grok-oauth.md
# --- I2V operating profile ---
# grok_primary = Grok image_to_video bulk primary (no FRW canary required); on_camera dialogue keeps FRW LTX 2.3 native-audio
# ltx23_primary = legacy FRW LTX 2.3 img2video-audio primary (requires a fresh approved canary)
AIFILM_I2V_PROFILE=grok_primary
# hybrid_h3 = Grok bulk + restricted/meat soft-lock local MiniMax H3 pilot
# AIFILM_I2V_PROFILE=hybrid_h3
AIFILM_SEEDANCE_AVAILABLE=0
# Legacy only: AIFILM_I2V_PROFILE=seedance_first + AIFILM_SEEDANCE_AVAILABLE=1

# --- Private RTX 5090 ComfyUI (explicit local lane; never silent default) ---
# SSH tunnel: ssh -fN -L 18188:127.0.0.1:8189 user@192.168.88.52
# AIFILM_COMFYUI_BASE_URL=http://127.0.0.1:18188
# AIFILM_COMFY_BROKER_TOKEN=  # owner-only secret; never commit it
# Bounded recovery (no key contents or prompts are written to receipts):
# AIFILM_COMFY_SSH_TARGET=user@192.168.88.52
# AIFILM_COMFY_SSH_KEY=~/.ssh/aifilm_5090_ed25519
# AIFILM_COMFY_SSH_KNOWN_HOSTS=~/.ssh/known_hosts
# AIFILM_COMFY_SSH_HOSTKEY_ALIAS=192.168.88.52
# AIFILM_COMFY_TUNNEL_PORT=18188
# AIFILM_COMFY_REMOTE_PORT=8188
# AIFILM_COMFY_REMOTE_ROOT=C:\ComfyUI_windows_portable
# Probe failure only: aifilm comfy recover --confirm
# Read-only: aifilm comfy probe && aifilm comfy inventory && aifilm comfy queue
# Workflows must use File → Export Workflow (API); external API nodes fail closed.
# See: references/comfy-lan-control.md
# Adult profile requires --subject-basis fictional_adults|licensed_adults.
# It rejects minor/young-looking signals and never auto-enables act-specific LoRAs.

# --- FRW (Seedance / LTX / lipsync) ---
# FRW_API_KEY=
# FRWCLAW_ROOT=
# Local-only HMAC key for production provider-switch receipts (minimum 32 characters).
AIFILM_PROVIDER_SWITCH_RECEIPT_KEY=
# Used by env-plate / lipsync / seedance canary. See frw-degrade-dispatch.md

# --- External music generation (optional) ---
# AIFILM_MUSIC_ARGV=["python3","/path/to/music_gen.py","--prompt","{prompt}","--out","{out}"]
# AIFILM_MUSIC_PROMPT=default mood text
# AIFILM_MUSIC_TIMEOUT=600
# AIFILM_MUSIC_REQUIRE=0          # 1 = fail final if music gen fails (no procedural fallback)
# AIFILM_MUSIC_LICENSE=           # license note for externally generated music

# --- CosyVoice TTS (optional HTTP backend) ---
# COSYVOICE_BASE_URL=http://127.0.0.1:9880
# COSYVOICE_ENDPOINT=/tts
# COSYVOICE_PAYLOAD_STYLE=shengwang   # shengwang | funaudio | openaiish
# COSYVOICE_REF_WAV=                 # reference wav for zero-shot cloning
# COSYVOICE_SPEAKER=default
# COSYVOICE_LANGUAGE=zh
# COSYVOICE_PROMPT_TEXT=
# COSYVOICE_REF_AS_B64=0
# COSYVOICE_MODE=zero_shot       # zero_shot needs authorized ref + transcript; sft uses built-in speaker
# COSYVOICE_SPEAKER=中文女        # only for COSYVOICE_MODE=sft
# COSYVOICE_TEXT_FRONTEND=1       # set 0 only for offline/pre-normalized canaries

# Offline Kokoro Chinese (Apache-2.0). Keep explicit: it is not the film default.
# The adapter uses only its fixed audited model from the local cache; it never downloads.
# KOKORO_VOICE=zf_001
# KOKORO_DEVICE=auto
# CHATTERBOX_DEVICE=auto       # explicit offline route: mps | cpu | cuda
# CHATTERBOX_LANGUAGE=zh       # zh | ja; model uses its built-in voice only
# AIFILM_TTS_BACKEND=kokoro-local
# AIFILM_TTS_ARGV=["/absolute/path/.local-runtimes/kokoro-zh/bin/python","/absolute/path/skills/ai-film-grok/scripts/adapters/kokoro_tts.py","--text-file","{text_file}","--out","{out}","--voice","{voice}"]

# --- OpenAI-compatible endpoints (optional; for xai-sdk / external adapters) ---
# OPENAI_BASE_URL=
# XAI_BASE_URL=                      # alias for AIFILM_GROK_API_BASE
# XAI_MODEL=                         # model name for xai-sdk chat/completion

# --- Production gates (emergency overrides; test only) ---
# AIFILM_SKIP_PILOT_GATE=0           # 1 = skip pilot approval gate
# AIFILM_SKIP_LOOP_RISK_GATE=0      # 1 = skip loop risk gate
# AIFILM_STRICT_TTS_REHEARSAL=0     # 1 = enforce strict TTS rehearsal checks

# Prefer 0 unless the SSH nvidia-smi probe is fully verified (HostKeyAlias + tunnel argv).
#AIFILM_COMFY_DRIVER_VRAM_FALLBACK=0
