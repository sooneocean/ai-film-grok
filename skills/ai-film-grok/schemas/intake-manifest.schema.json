{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dex/ai-film-grok/intake-manifest.schema.json",
  "title": "ai-film-grok multimodal intake manifest",
  "type": "object",
  "required": ["schema_version", "kind", "story", "characters", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ai-film-intake"},
    "story": {"type": "object", "required": ["kind", "source_ref", "file"]},
    "characters": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "reference_image"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "aliases": {"type": "array", "items": {"type": "string"}}, "reference_image": {"type": "object", "required": ["path", "sha256"]}, "review_status": {"enum": ["needs_review", "approved"]}}}},
    "status": {"enum": ["staged", "review", "approved", "stale"]}
  }
}
