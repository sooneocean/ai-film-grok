{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dex/ai-film-grok/film-spec.schema.json",
  "title": "ai-film-grok film-spec",
  "type": "object",
  "required": ["title", "vo_mode", "director_intent", "scenes"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "_projection": {
      "type": "object",
      "required": ["source", "source_revision", "source_sha256", "generated_at"],
      "properties": {
        "source": { "const": "drama-graph.json" },
        "source_revision": { "type": "integer", "minimum": 1 },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "generated_at": { "type": "string" },
        "state": { "type": "string" }
      }
    },
    "aspect_ratio": { "enum": ["9:16", "16:9", "1:1", "3:4", "4:3"] },
    "genre": {
      "type": "string",
      "enum": ["adult", "drama", "mystery", "arthouse", "documentary"],
      "description": "Beat spine selector. Determines which beat template drives dramatic_function assignment. See references/beat-spines.md. Default: adult (backward compat)."
    },
    "vo_mode": { "enum": ["storyteller", "character", "hybrid"] },
    "audio_tracks_strict": {
      "type": "boolean",
      "description": "Require explicit dialogue/BGM/SFX contract and rendered artifact evidence. Defaults false for backward compatibility."
    },
    "audio_cues_strict": {
      "type": "boolean",
      "description": "Require every shot to declare its timed audio cues. Legacy projects remain compatible when false."
    },
    "audio_tracks": {
      "type": "object",
      "properties": {
        "dialogue": { "type": "object", "additionalProperties": true },
        "sfx": { "type": "object", "additionalProperties": true },
        "music": { "type": "object", "additionalProperties": true },
        "bgm": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "tts_backend": { "enum": ["auto", "minimax", "fish", "voicebox", "edge", "external"] },
    "i2v_provider": {
      "enum": ["frw", "grok", "auto"],
      "description": "Bulk motion provider. Default/auto→frw (Seedance). Grok for identity stills / I2V fallback."
    },
    "frw_video_model": {
      "enum": [
        "seedance-2-fast-i2v",
        "seedance-2-fast-t2v",
        "seedance-2-pro-flf",
        "seedance-2-pro-t2v",
        "byteplus-seedance-2-i2v",
        "byteplus-seedance-2-flf",
        "byteplus-seedance-2-t2v",
        "ltx-i2v",
        "ltx-t2v",
        "ltx-flf",
        "ltx-lipsync",
        "legacy-img2video",
        "auto"
      ],
      "description": "FRW NEW_VIDEO model. Default seedance-2-fast-i2v. LTX needs string width/height. Never default legacy-img2video."
    },
    "frw_aspect_ratio": { "type": "string", "description": "Seedance aspect e.g. 9:16" },
    "frw_resolution": {
      "type": "string",
      "description": "Native Seedance resolution e.g. 720p. Do not generate 576 then upscale."
    },
    "frw_duration": {
      "type": "string",
      "description": "Duration string e.g. \"5\" (LTX maps to video_duration)"
    },
    "frw_fps": {
      "type": "string",
      "description": "LTX video_fps string e.g. \"24\""
    },
    "frw_width": {
      "type": "string",
      "description": "LTX width string; 9:16 use \"720\" (not int)"
    },
    "frw_height": {
      "type": "string",
      "description": "LTX height string; 9:16 use \"1280\""
    },
    "frw_env_model": {
      "enum": [
        "ltx-t2v",
        "seedance-2-fast-t2v",
        "byteplus-seedance-2-t2v",
        "legacy-text2video",
        "auto"
      ],
      "description": "Env/synth bed T2V model (no face). Default ltx-t2v. Not for hero identity."
    },
    "caption_mode": {
      "enum": ["zh", "zh_en", "en"],
      "description": "Designed-post captions; zh_en needs per-shot nar_en"
    },
    "heat_scale": {
      "enum": ["soft", "medium", "hot", "max"],
      "description": "Adult/ecchi heat. Default max for adult briefs. See ecchi-story.md"
    },
    "intimacy_min_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Max films: min share of shots in foreplay+act+climax (default 0.60 advisory)"
    },
    "setup_max_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Max films: max share of setup-phase shots (default 0.25 advisory)"
    },
    "sex_min_duration_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Min duration_sec share of act+climax (性爱片段). Default 0.50 for heat_scale=max (adult max IRON 2026-07-24); hardcore_male default 0.55"
    },
    "sex_floor_strict": {
      "type": "boolean",
      "description": "Hard-fail write-spec when HEAT_SEX_DURATION_LOW. Default true when heat_scale=max"
    },
    "sex_wardrobe_strict": {
      "type": "boolean",
      "description": "Hard-fail when act/climax not undressed|bare, bare peak missing, undress beat missing, or re-dress (HEAT_BARE_PEAK_MISSING / HEAT_WARDROBE_*). Default true when heat_scale=max. IRON: act≥undressed, climax=bare."
    },
    "sex_vo_strict": {
      "type": "boolean",
      "description": "Hard-fail when nar lacks 荤梗 or act/climax lack sex verbs. Default true when heat_scale=max"
    },
    "heat_arc_strict": {
      "type": "boolean",
      "description": "Hard-fail when intimacy core <70% or setup >20% on max (HEAT_INTIMACY_RATIO_LOW / HEAT_SETUP_RATIO_HIGH). Default true when heat_scale=max."
    },
    "adult_max_iron": {
      "type": "boolean",
      "description": "When false, disable auto heat_arc_strict default on max. Agent must not set false to pass gates without user consent."
    },
    "heat_arc_strict": {
      "type": "boolean",
      "description": "If true, all heat arc lint warnings hard-fail write-spec"
    },
    "cast_mode": {
      "enum": ["auto", "single", "multi"],
      "description": "Heroine count mode. auto=infer from prompt/images; default resolves to single"
    },
    "user_prompt": {
      "type": "string",
      "description": "Raw user brief for cast_mode / heat inference"
    },
    "female_ref_image_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of user-provided female face/body refs (multi when ≥2 + cues)"
    },
    "cast_ref_images": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths/URLs of cast reference images"
    },
    "multi_heroine": {
      "type": "boolean",
      "description": "Explicit multi-heroine. Prefer cast_mode; auto may set true when evidence"
    },
    "heroine_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Cast ids for each heroine (each needs cast master)"
    },
    "cast_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional full cast id list"
    },
    "title_sequence": {
      "type": "object",
      "properties": {
        "subtitle": { "type": "string" },
        "tagline": { "type": "string" },
        "show_motifs": { "type": "boolean", "default": true },
        "style": {
          "type": "string",
          "enum": ["auto", "cinematic", "noir", "playful", "ecchi-rnb", "minimal"]
        }
      },
      "additionalProperties": true
    },
    "end_roll": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto", "full", "cast_only", "none"],
          "default": "auto"
        },
        "cast_heading": { "type": "string", "default": "Cast" },
        "crew_heading": { "type": "string", "default": "Crew" },
        "show_shot_list": { "type": "boolean", "default": false },
        "scroll_duration_sec": {
          "type": "number",
          "minimum": 2,
          "maximum": 12,
          "default": 5
        }
      },
      "additionalProperties": true
    },
    "multi_heroine_strict": {
      "type": "boolean",
      "description": "If true, multi-heroine lint hard-fails write-spec"
    },
    "edit_craft": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Per-join senior edit craft (n_shots-1). See references/editorial-craft.md"
      }
    },
    "transition_fluency": {
      "enum": ["auto", "silk", "punchy", "cinematic"],
      "description": "auto→silk; cinematic=edit_craft rich rhythm; continue seams always hard"
    },
    "tts_allow_network_fallback": { "type": "boolean", "default": false },
    "native_audio_volume": { "type": "number", "minimum": 0, "maximum": 1 },
    "transition_sec": { "type": "number", "minimum": 0, "maximum": 0.6 },
    "transition_default": { "enum": ["hard", "soft", "hold"] },
    "transition_style": {
      "type": "string",
      "description": "Default xfade style for soft/hold (and title/end edges). One of fade|fadeblack|fadewhite|smoothleft|smoothright|smoothup|smoothdown|hblur|dissolve."
    },
    "transition_intents": {
      "type": "array",
      "items": { "enum": ["hard", "soft", "hold"] },
      "description": "Per story join hard|soft|hold; length must be n_shots-1"
    },
    "transition_styles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fade",
          "fadeblack",
          "fadewhite",
          "smoothleft",
          "smoothright",
          "smoothup",
          "smoothdown",
          "hblur",
          "dissolve"
        ]
      },
      "description": "Per-join xfade style names; length n_shots-1. Hard joins ignore style (concat)."
    },
    "audio_policy": {
      "type": "object",
      "description": "Scene-adaptive audio routing. Default mode=auto never auto-sings. See references/audio-recipe.md",
      "properties": {
        "mode": {
          "enum": ["auto", "storyteller_only", "musical_hybrid"]
        },
        "allow_sung": { "type": "boolean" },
        "allow_lipsync": { "type": "boolean" },
        "bed_source": {
          "enum": ["auto", "library_only", "procedural_only"]
        },
        "max_sung_shots": { "type": "integer", "minimum": 0 },
        "music_seed": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "content_channels_strict": {
      "type": "boolean",
      "default": false,
      "description": "Require explicit separation of voice, performance, motion, and in-scene triggers."
    },
    "subtitle_carryovers": {
      "type": "array",
      "description": "Explicit human-approved subtitle carry-over across a hard/Continue cut.",
      "items": {
        "type": "object",
        "required": ["from_shot_id", "to_shot_id", "cue_start_sec", "cue_end_sec", "reason", "human_approved"],
        "properties": {
          "from_shot_id": {"type": "string", "minLength": 1},
          "to_shot_id": {"type": "string", "minLength": 1},
          "cue_start_sec": {"type": "number", "minimum": 0},
          "cue_end_sec": {"type": "number", "exclusiveMinimum": 0},
          "reason": {"type": "string", "minLength": 3},
          "human_approved": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "transition_ops": {
      "type": "array",
      "description": "One explicit editorial operation per inter-shot seam. Generated from edit_craft; author entries may add locked/reason.",
      "items": {
        "type": "object",
        "properties": {
          "locked": { "type": "boolean" },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "sound_plan": {
      "type": "object",
      "properties": {
        "mood": {
          "type": "string",
          "minLength": 1,
          "description": "BGM mood. 色气默认 rnb (aliases: soul/sensual). dark=horror only."
        },
        "bed": { "type": "boolean" },
        "bed_gain_hint": {
          "type": "number",
          "description": "Mean bed gain from audio_recipe routing (write-spec)"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["mute", "sfx_accent", "duck", "music_in", "music_out", "fade_in", "fade_out"] },
              "shot_id": { "type": "string" },
              "duration_sec": { "type": "number" },
              "kind": { "type": "string" },
              "depth": { "type": "number" },
              "at_sec": { "type": "number" }
            },
            "additionalProperties": true
          }
        },
        "music_spotting": {
          "type": "array",
          "description": "P3-3: BGM spotting sheet — music entry/exit/fade aligned to narrative beats.",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string", "description": "e.g. 'main_theme', 'tension_rise', 'climax_hit'" },
              "start_sec": { "type": "number", "description": "Music entry point in seconds" },
              "end_sec": { "type": "number", "description": "Music exit point in seconds" },
              "fade_in_sec": { "type": "number", "description": "Fade-in duration" },
              "fade_out_sec": { "type": "number", "description": "Fade-out duration" },
              "emotion": { "type": "string", "description": "Emotional function of this music segment" },
              "beat_ref": { "type": "string", "description": "Beat id this music segment serves" },
              "intensity": { "type": "number", "minimum": 0, "maximum": 10, "description": "Music intensity 0-10" }
            }
          }
        },
        "audio_tracks": {
          "type": "object",
          "description": "P3-2: Multi-track audio mixing — independent tracks with各自的 gain/ducking.",
          "properties": {
            "dialogue": { "type": "object", "properties": { "gain": {"type":"number"}, "duck_to_bgm": {"type":"boolean"} } },
            "sfx": { "type": "object", "properties": { "gain": {"type":"number"}, "duck_to_bgm": {"type":"boolean"} } },
            "ambience": { "type": "object", "properties": { "gain": {"type":"number"} } },
            "foley": { "type": "object", "properties": { "gain": {"type":"number"} } },
            "music": { "type": "object", "properties": { "gain": {"type":"number"}, "sidechain_duck": {"type":"boolean"} } }
          }
        }
      },
      "additionalProperties": true
    },
    "continuity_strict": { "type": "boolean" },
    "grade": {
      "type": "object",
      "description": "P3-1: Color grading parameters. From 0/10 to parameterized. color_grade_strict: true → COLOR_GRADE_MISSING gate in post_audit.",
      "properties": {
        "lut_path": { "type": "string", "description": "Path to LUT file (.cube) for color grading" },
        "color_temperature": { "type": "string", "description": "Target color temperature (warm/cool/neutral + Kelvin)" },
        "saturation": { "type": "number", "minimum": 0, "maximum": 3, "description": "Saturation multiplier (1.0 = normal)" },
        "contrast": { "type": "number", "minimum": 0, "maximum": 2, "description": "Contrast multiplier (1.0 = normal)" },
        "brightness": { "type": "number", "minimum": 0, "maximum": 2, "description": "Brightness multiplier (1.0 = normal)" },
        "skin_tone_protection": { "type": "boolean", "description": "If true, protect skin tones from grade drift" },
        "gamma": { "type": "number", "minimum": 0.1, "maximum": 3, "description": "Gamma adjustment (1.0 = normal)" }
      }
    },
    "color_grade_strict": { "type": "boolean", "description": "P3-1: If true, post_audit hard-fails when grade is missing or incomplete" },
    "lufs_strict": { "type": "boolean", "description": "P3-4: If true, LUFS out of range → hard failure (LUFS_OUT_OF_RANGE). Default: warning only." },
    "lufs_min": { "type": "number", "default": -23, "description": "P3-4: Minimum acceptable integrated LUFS (EBU R128 default -23)" },
    "lufs_max": { "type": "number", "default": -14, "description": "P3-4: Maximum acceptable integrated LUFS (streaming default -14)" },
    "vo_voice": { "type": "string", "minLength": 1 },
    "director_intent": {
      "type": "object",
      "required": ["logline", "tone", "emotional_arc"],
      "properties": {
        "logline": { "type": "string", "minLength": 8 },
        "tone": { "type": "string", "minLength": 1 },
        "emotional_arc": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "act_structure": {
          "type": "object",
          "description": "Three-act structure with ratio and beat anchors. See references/directors-lens.md. pace_chart_strict: true → write-spec enforces non-empty.",
          "properties": {
            "setup": { "type": "string", "minLength": 1, "description": "Act 1: setup — world, character, inciting incident" },
            "confrontation": { "type": "string", "minLength": 1, "description": "Act 2: confrontation — obstacles, rising action, midpoint turn" },
            "resolution": { "type": "string", "minLength": 1, "description": "Act 3: resolution — climax, denouement, new normal" },
            "setup_ratio": { "type": "number", "minimum": 0.05, "maximum": 0.50, "description": "Act 1 proportion (default 0.20, classic 1:2:1)" },
            "confrontation_ratio": { "type": "number", "minimum": 0.20, "maximum": 0.70, "description": "Act 2 proportion (default 0.50)" },
            "resolution_ratio": { "type": "number", "minimum": 0.05, "maximum": 0.50, "description": "Act 3 proportion (default 0.30)" }
          }
        },
        "pace_chart": {
          "type": "array",
          "description": "Structured rhythm curve: each entry has start_tc, end_tc, cut_freq, emotion_intensity. pace_chart_strict: true → write-spec enforces non-empty + ratios match act_structure.",
          "items": {
            "type": "object",
            "required": ["label", "start_ratio", "end_ratio", "intensity"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "description": "e.g. 慢燃/加速/高潮/释放" },
              "start_ratio": { "type": "number", "minimum": 0, "maximum": 1, "description": "Start position as ratio of total duration (0-1)" },
              "end_ratio": { "type": "number", "minimum": 0, "maximum": 1, "description": "End position as ratio of total duration (0-1)" },
              "cut_freq": { "type": "string", "enum": ["slow", "medium", "fast", "rapid"], "description": "Target cut frequency for this segment" },
              "intensity": { "type": "number", "minimum": 0, "maximum": 10, "description": "Emotional intensity 0-10 for this segment" }
            }
          },
          "minItems": 3
        },
        "audience": { "type": "string", "minLength": 1 },
        "protagonist_want": {
          "type": "string",
          "minLength": 1,
          "description": "What the protagonist consciously wants (external goal). character_bible_strict: true → required."
        },
        "protagonist_need": {
          "type": "string",
          "minLength": 1,
          "description": "What the protagonist actually needs (internal growth). character_bible_strict: true → required."
        },
        "protagonist_arc": {
          "type": "string",
          "minLength": 1,
          "description": "Protagonist arc: A→B state change. character_bible_strict: true → required."
        },
        "taboos": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shots"],
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "director_board": {
            "type": "object",
            "description": "Director decision board per scene — the questions a director answers at a production meeting. Mirrors drama-graph beat.director_board; write-spec lints authored (non-placeholder) on scene_strict.",
            "properties": {
              "emotional_turn": {
                "type": "string",
                "description": "Where the audience's feeling pivots in this scene. e.g. 'curiosity → voyeuristic pull'"
              },
              "audience_question": {
                "type": "string",
                "description": "The question the scene makes the audience hold. e.g. 'will she close the distance?'"
              },
              "coverage_strategy": {
                "type": "string",
                "description": "What coverage serves the scene's turn — insert on object, OTS reverse, wide hold?"
              },
              "cut_intent": {
                "type": "string",
                "description": "How this scene should cut — smash on the turn, hold on the afterglow, montage on the act?"
              },
              "image_priority": { "type": "string" },
              "sound_priority": { "type": "string" },
              "approval_state": {
                "type": "string",
                "enum": ["draft", "review", "approved"],
                "description": "approved required before bulk generate when scene_strict=true"
              }
            },
            "additionalProperties": true
          },
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "nar", "dramatic_function", "dsl"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "title": { "type": "string" },
                "nar": { "type": "string", "minLength": 1 },
                "dramatic_function": {
                  "type": "string",
                  "enum": [
                    "hook",
                    "approach",
                    "sensory",
                    "reaction",
                    "action",
                    "afterglow",
                    "bridge"
                  ]
                },
                "duration_sec": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
                "audio_cues": {
                  "type": "array",
                  "description": "Timed, shot-relative audio plan. Only kind=voice may carry spoken_text for TTS.",
                  "items": {
                    "type": "object",
                    "required": ["kind", "start_offset_sec", "duration_sec"],
                    "properties": {
                      "kind": {"enum": ["voice", "foley", "sfx", "ambience", "music", "silence"]},
                      "start_offset_sec": {"type": "number", "minimum": 0},
                      "duration_sec": {"type": "number", "exclusiveMinimum": 0},
                      "speaker": {"type": "string"},
                      "line_type": {"enum": ["dialogue", "inner_monologue", "phone_broadcast", "narration"]},
                      "spoken_text": {"type": "string"},
                      "emotion": {"type": "string"},
                      "performance": {"type": "object"},
                      "asset_hint": {"type": "string"},
                      "purpose": {"type": "string"}
                    },
                    "additionalProperties": true
                  }
                },
                "lipsync": { "type": "boolean" },
                "dialogue": { "type": "string" },
                "music_cue": {
                  "type": "object",
                  "description": "Per-shot emotional BGM direction; compiled into procedural stems or source automation.",
                  "properties": {
                    "mood": { "type": "string", "enum": ["rnb", "dark", "ambient", "warm", "playful"] },
                    "energy": { "type": "number", "minimum": 0, "maximum": 1 },
                    "density": { "type": "number", "minimum": 0, "maximum": 1 },
                    "bass_presence": { "type": "number", "minimum": 0, "maximum": 1 },
                    "brightness": { "type": "number", "minimum": 0, "maximum": 1 },
                    "duck_db": { "type": "number", "minimum": -18, "maximum": 0 },
                    "bpm": { "type": "number", "minimum": 40, "maximum": 180 },
                    "key_shift": { "type": "integer", "minimum": -12, "maximum": 12 },
                    "stem_profile": { "type": "string", "enum": ["full", "thin", "pulse", "pad", "bass", "silence"] },
                    "motif_id": { "type": "string", "minLength": 1, "maxLength": 80 },
                    "transition": { "type": "string", "enum": ["crossfade", "cut", "stinger"] }
                  },
                  "additionalProperties": false
                },
                "speaker_on_camera": { "type": "boolean" },
                "scene_trigger": { "type": "string" },
                "content_channels": {
                  "type": "object",
                  "properties": {
                    "voice": { "type": "object" },
                    "performance": { "type": "object" },
                    "motion": { "type": "object" }
                  }
                },
                "heat_phase": {
