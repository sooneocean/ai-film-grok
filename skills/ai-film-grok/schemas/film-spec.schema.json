{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dex/ai-film-grok/film-spec.schema.json",
  "title": "ai-film-grok film-spec",
  "type": "object",
  "required": ["title", "vo_mode", "director_intent", "scenes"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "aspect_ratio": { "enum": ["9:16", "16:9", "1:1", "3:4", "4:3"] },
    "vo_mode": { "enum": ["storyteller", "character", "hybrid"] },
    "tts_backend": { "enum": ["auto", "minimax", "fish", "voicebox", "edge", "external"] },
    "i2v_provider": {
      "enum": ["frw", "grok", "auto"],
      "description": "Bulk motion provider. Default/auto→frw (Seedance). Grok for identity stills / I2V fallback."
    },
    "frw_video_model": {
      "enum": [
        "seedance-2-fast-i2v",
        "seedance-2-fast-t2v",
        "seedance-2-pro-flf",
        "seedance-2-pro-t2v",
        "byteplus-seedance-2-i2v",
        "byteplus-seedance-2-flf",
        "byteplus-seedance-2-t2v",
        "ltx-i2v",
        "ltx-t2v",
        "ltx-flf",
        "ltx-lipsync",
        "legacy-img2video",
        "auto"
      ],
      "description": "FRW NEW_VIDEO model. Default seedance-2-fast-i2v. LTX needs string width/height. Never default legacy-img2video."
    },
    "frw_aspect_ratio": { "type": "string", "description": "Seedance aspect e.g. 9:16" },
    "frw_resolution": {
      "type": "string",
      "description": "Native Seedance resolution e.g. 720p. Do not generate 576 then upscale."
    },
    "frw_duration": {
      "type": "string",
      "description": "Duration string e.g. \"5\" (LTX maps to video_duration)"
    },
    "frw_fps": {
      "type": "string",
      "description": "LTX video_fps string e.g. \"24\""
    },
    "frw_width": {
      "type": "string",
      "description": "LTX width string; 9:16 use \"720\" (not int)"
    },
    "frw_height": {
      "type": "string",
      "description": "LTX height string; 9:16 use \"1280\""
    },
    "frw_env_model": {
      "enum": [
        "ltx-t2v",
        "seedance-2-fast-t2v",
        "byteplus-seedance-2-t2v",
        "legacy-text2video",
        "auto"
      ],
      "description": "Env/synth bed T2V model (no face). Default ltx-t2v. Not for hero identity."
    },
    "caption_mode": {
      "enum": ["zh", "zh_en", "en"],
      "description": "Designed-post captions; zh_en needs per-shot nar_en"
    },
    "heat_scale": {
      "enum": ["soft", "medium", "hot", "max"],
      "description": "Adult/ecchi heat. Default max for adult briefs. See ecchi-story.md"
    },
    "intimacy_min_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Max films: min share of shots in foreplay+act+climax (default 0.60 advisory)"
    },
    "setup_max_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Max films: max share of setup-phase shots (default 0.25 advisory)"
    },
    "sex_min_duration_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Min duration_sec share of act+climax (性爱片段). Default 0.20 for heat_scale=max; hardcore_male default 0.40"
    },
    "sex_floor_strict": {
      "type": "boolean",
      "description": "Hard-fail write-spec when HEAT_SEX_DURATION_LOW. Default true when heat_scale=max"
    },
    "sex_wardrobe_strict": {
      "type": "boolean",
      "description": "Hard-fail when act/climax still full armor/dress, undress beat missing, or wardrobe re-dresses mid-film (HEAT_WARDROBE_RE_DRESS). Default true when heat_scale=max. Continuity: wardrobe_state rank only rises; later shots inherit prior undress."
    },
    "sex_vo_strict": {
      "type": "boolean",
      "description": "Hard-fail when nar lacks 荤梗 or act/climax lack sex verbs. Default true when heat_scale=max"
    },
    "heat_arc_strict": {
      "type": "boolean",
      "description": "If true, all heat arc lint warnings hard-fail write-spec"
    },
    "cast_mode": {
      "enum": ["auto", "single", "multi"],
      "description": "Heroine count mode. auto=infer from prompt/images; default resolves to single"
    },
    "user_prompt": {
      "type": "string",
      "description": "Raw user brief for cast_mode / heat inference"
    },
    "female_ref_image_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of user-provided female face/body refs (multi when ≥2 + cues)"
    },
    "cast_ref_images": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths/URLs of cast reference images"
    },
    "multi_heroine": {
      "type": "boolean",
      "description": "Explicit multi-heroine. Prefer cast_mode; auto may set true when evidence"
    },
    "heroine_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Cast ids for each heroine (each needs cast master)"
    },
    "cast_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional full cast id list"
    },
    "title_sequence": {
      "type": "object",
      "properties": {
        "subtitle": { "type": "string" },
        "tagline": { "type": "string" },
        "show_motifs": { "type": "boolean", "default": true },
        "style": {
          "type": "string",
          "enum": ["auto", "cinematic", "noir", "playful", "ecchi-rnb", "minimal"]
        }
      },
      "additionalProperties": true
    },
    "end_roll": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto", "full", "cast_only", "none"],
          "default": "auto"
        },
        "cast_heading": { "type": "string", "default": "Cast" },
        "crew_heading": { "type": "string", "default": "Crew" },
        "show_shot_list": { "type": "boolean", "default": false },
        "scroll_duration_sec": {
          "type": "number",
          "minimum": 2,
          "maximum": 12,
          "default": 5
        }
      },
      "additionalProperties": true
    },
    "multi_heroine_strict": {
      "type": "boolean",
      "description": "If true, multi-heroine lint hard-fails write-spec"
    },
    "edit_craft": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Per-join senior edit craft (n_shots-1). See references/editorial-craft.md"
      }
    },
    "transition_fluency": {
      "enum": ["auto", "silk", "punchy", "cinematic"],
      "description": "auto→silk; cinematic=edit_craft rich rhythm; continue seams always hard"
    },
    "tts_allow_network_fallback": { "type": "boolean", "default": false },
    "native_audio_volume": { "type": "number", "minimum": 0, "maximum": 1 },
    "transition_sec": { "type": "number", "minimum": 0, "maximum": 0.6 },
    "transition_default": { "enum": ["hard", "soft", "hold"] },
    "transition_style": {
      "type": "string",
      "description": "Default xfade style for soft/hold (and title/end edges). One of fade|fadeblack|fadewhite|smoothleft|smoothright|smoothup|smoothdown|hblur|dissolve."
    },
    "transition_intents": {
      "type": "array",
      "items": { "enum": ["hard", "soft", "hold"] },
      "description": "Per story join hard|soft|hold; length must be n_shots-1"
    },
    "transition_styles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fade",
          "fadeblack",
          "fadewhite",
          "smoothleft",
          "smoothright",
          "smoothup",
          "smoothdown",
          "hblur",
          "dissolve"
        ]
      },
      "description": "Per-join xfade style names; length n_shots-1. Hard joins ignore style (concat)."
    },
    "audio_policy": {
      "type": "object",
      "description": "Scene-adaptive audio routing. Default mode=auto never auto-sings. See references/audio-recipe.md",
      "properties": {
        "mode": {
          "enum": ["auto", "storyteller_only", "musical_hybrid"]
        },
        "allow_sung": { "type": "boolean" },
        "allow_lipsync": { "type": "boolean" },
        "bed_source": {
          "enum": ["auto", "library_only", "procedural_only"]
        },
        "max_sung_shots": { "type": "integer", "minimum": 0 },
        "music_seed": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "sound_plan": {
      "type": "object",
      "properties": {
        "mood": {
          "type": "string",
          "minLength": 1,
          "description": "BGM mood. 色气默认 rnb (aliases: soul/sensual). dark=horror only."
        },
        "bed": { "type": "boolean" },
        "bed_gain_hint": {
          "type": "number",
          "description": "Mean bed gain from audio_recipe routing (write-spec)"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["mute", "sfx_accent", "duck"] },
              "shot_id": { "type": "string" },
              "duration_sec": { "type": "number" },
              "kind": { "type": "string" },
              "depth": { "type": "number" },
              "at_sec": { "type": "number" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "continuity_strict": { "type": "boolean" },
    "vo_voice": { "type": "string", "minLength": 1 },
    "director_intent": {
      "type": "object",
      "required": ["logline", "tone", "emotional_arc"],
      "properties": {
        "logline": { "type": "string", "minLength": 8 },
        "tone": { "type": "string", "minLength": 1 },
        "emotional_arc": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "audience": { "type": "string", "minLength": 1 },
        "taboos": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shots"],
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "shots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "nar", "dramatic_function", "dsl"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "title": { "type": "string" },
                "nar": { "type": "string", "minLength": 1 },
                "dramatic_function": {
                  "type": "string",
                  "enum": [
                    "hook",
                    "approach",
                    "sensory",
                    "reaction",
                    "action",
                    "afterglow",
                    "bridge"
                  ]
                },
                "duration_sec": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
                "lipsync": { "type": "boolean" },
                "heat_phase": {
                  "type": "string",
                  "enum": ["setup", "foreplay", "act", "climax", "afterglow", "bridge"],
                  "description": "Adult heat arc phase; intimacy core = foreplay+act+climax"
                },
                "wardrobe_state": {
                  "type": "string",
                  "enum": ["full", "armored", "partial", "undressed", "bare"],
                  "description": "Costume ladder (monotonic undress). act/climax must be partial|undressed|bare. Later shots must not re-dress below prior peak. Missing → inherit previous on write-spec. See sex-undress-ladder lesson."
                },
                "dsl": {
                  "type": "object",
                  "description": "Visual DSL; write-spec fills motion/shot_size/camera_axis from beat defaults",
                  "properties": {
                    "motion": { "type": "string", "minLength": 1 },
                    "camera_axis": {
                      "type": "string",
                      "enum": [
                        "dolly_in",
                        "pan_with",
                        "locked",
                        "ecu_hold",
                        "low_lean",
                        "pull_back"
                      ],
                      "description": "Camera axis rotated across shots (v2). write-spec injects if missing."
                    },
                    "focal_character": {
                      "type": "string",
                      "description": "Whose stance/empathy this shot serves (hero/partner/cast id). See character-stance.md"
                    },
                    "viewpoint": {
                      "type": "string",
                      "enum": [
                        "objective",
                        "subjective_pov",
                        "ots",
                        "reverse",
                        "reaction_to",
                        "dual",
                        "insert_object"
                      ],
                      "description": "Multi-POV grammar: whose eyes / reverse / reaction"
                    },
                    "look_axis": {
                      "type": "string",
                      "enum": ["left", "right", "center"],
                      "description": "Screen direction for 180-degree continuity; reverse flips"
                    },
                    "wardrobe_state": {
                      "type": "string",
                      "enum": ["full", "armored", "partial", "undressed", "bare"],
                      "description": "Same as shot.wardrobe_state; act sex must not stay full/armored"
                    },
                    "chain_mode": {
                      "type": "string",
                      "description": "continue = byte match-cut chain; cut = new jump. continue joins force hard transition."
                    },
                    "cut_on": {
                      "type": "string",
                      "description": "mid_motion preferred on continue for energy continuity"
                    },
                    "visible_change": { "type": "string" },
                    "story_beat": { "type": "string" },
                    "action": { "type": "string" },
                    "start_pose": { "type": "string" },
                    "end_pose": { "type": "string" },
                    "nar_en": { "type": "string" },
                    "camera": {
                      "type": "object",
                      "properties": {
                        "shot_size": { "type": "string" },
                        "angle": { "type": "string" }
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                },
                "nar_en": {
                  "type": "string",
                  "description": "English caption line for caption_mode zh_en; not TTS by default"
                },
                "shot_role": {
                  "enum": ["hero", "env", "bridge", "insert"],
                  "description": "hero=face I2V; env/bridge/insert=LTX T2V synth beds (no identity claim)"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
