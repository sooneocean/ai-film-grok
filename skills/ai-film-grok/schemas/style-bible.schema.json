{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dex/ai-film-grok/style-bible.schema.json",
  "title": "ai-film-grok visual style bible v3",
  "type": "object",
  "required": ["schema_version", "kind", "revision", "state", "hash", "approval_ref", "stale_reasons", "nodes"],
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "kind": { "type": "string", "const": "visual-bible" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["draft", "review", "locked", "stale"] },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approval_ref": { "type": ["string", "null"] },
    "stale_reasons": { "type": "array", "items": { "type": "object" } },
    "nodes": {
      "type": "object",
      "required": ["face", "geometry", "body", "hair", "makeup", "wardrobe", "art", "location", "prop", "cinematography"],
      "properties": {
        "face": { "$ref": "#/$defs/parameterNode" },
        "geometry": { "$ref": "#/$defs/parameterNode" },
        "body": { "$ref": "#/$defs/parameterNode" },
        "hair": { "$ref": "#/$defs/parameterNode" },
        "makeup": { "$ref": "#/$defs/parameterNode" },
        "wardrobe": { "$ref": "#/$defs/parameterNode" },
        "art": { "$ref": "#/$defs/parameterNode" },
        "location": { "$ref": "#/$defs/parameterNode" },
        "prop": { "$ref": "#/$defs/parameterNode" },
        "cinematography": { "$ref": "#/$defs/parameterNode" }
      },
      "additionalProperties": true
    },
    "locked": { "type": "boolean" },
    "title": { "type": "string" },
    "medium": { "type": "string" },
    "palette": { "type": "string" },
    "lighting": { "type": "string" },
    "lens": { "type": "string" },
    "rendering": { "type": "string" },
    "signature_block": { "type": "string" },
    "negative_hints": { "type": "string" },
    "identity_lock": { "type": "string" },
    "characters": { "type": "object" },
    "wardrobe_variants": { "type": "object" },
    "cast_state_masters": { "type": "object" },
    "locations": { "type": "object" },
    "props": { "type": "object" },
    "continuity_states": { "type": "object" },
    "approved_keyframes": { "type": "object" },
    "updated_at": { "type": ["string", "null"] },
    "canonical_style_path": { "type": ["string", "null"] },
    "previous_versions": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "parameterNode": {
      "type": "object",
      "required": ["id", "revision", "hash", "source_refs", "dependency_refs", "state", "approval_ref", "stale_reasons", "data"],
      "properties": {
        "id": { "type": "string", "pattern": "^visual\\.[a-z0-9_-]+\\.primary$" },
        "revision": { "type": "integer", "minimum": 1 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "dependency_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "state": { "enum": ["draft", "review", "locked", "stale"] },
        "approval_ref": { "type": ["string", "null"] },
        "stale_reasons": { "type": "array", "items": { "type": "object" } },
        "data": {}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
