{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dex/ai-film-grok/capability-snapshot.schema.json",
  "title": "ai-film-grok capability snapshot",
  "type": "object",
  "required": ["schema_version", "kind", "generated_at", "capabilities"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "ai-film-capability-snapshot" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "model",
          "operations",
          "shot_roles",
          "content_classes",
          "status",
          "verified_at",
          "expires_at",
          "authorization",
          "pilot_verified",
          "experimental",
          "identity_lock_supported",
          "quality_floor",
          "quality_score",
          "priority",
          "resource",
          "concurrency",
          "cost_state"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "domains": {
            "type": "array",
            "items": {
              "enum": ["story", "visual_still", "motion", "voice", "lipsync", "music", "post", "qa"]
            },
            "uniqueItems": true
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "image_to_video",
                "text_to_video",
                "image_to_image",
                "text_to_speech",
                "face_animation_to_audio",
                "video_lip_sync"
              ]
            },
            "uniqueItems": true
          },
          "shot_roles": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["hero", "env", "bridge", "insert"] },
            "uniqueItems": true
          },
          "content_classes": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["general", "restricted_local"] },
            "uniqueItems": true
          },
          "status": { "enum": ["ready", "degraded", "blocked", "unknown"] },
          "verified_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "authorization": { "enum": ["ready", "missing", "blocked", "unknown"] },
          "pilot_verified": { "type": "boolean" },
          "experimental": { "type": "boolean" },
          "identity_lock_supported": { "type": "boolean" },
          "quality_tiers": {
            "type": "array",
            "items": { "enum": ["draft", "select", "hero"] },
            "uniqueItems": true
          },
          "quality_floor": { "type": "integer", "minimum": 0, "maximum": 5 },
          "quality_score": { "type": "integer", "minimum": 0, "maximum": 5 },
          "priority": { "type": "integer" },
          "resource": { "type": "string", "minLength": 1 },
          "concurrency": { "type": "integer", "minimum": 1 },
          "cost_state": { "enum": ["known", "unknown", "free_local"] },
          "cost_usd": { "type": ["number", "null"], "minimum": 0 },
          "human_approval_required": { "type": "boolean" },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "receipt_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
