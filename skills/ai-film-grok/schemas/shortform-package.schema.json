{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shortform Director Package v1",
  "type": "object",
  "required": ["schema_version", "kind", "mode", "status", "beats"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "shortform-director-package"},
    "mode": {"enum": ["topic", "aroll", "croll"]},
    "status": {"enum": ["pending_plan_review", "pending_sample_review", "approved_for_production", "candidate_assembled"]},
    "source": {"type": "object"},
    "anchor": {"type": "object"},
    "beats": {"type": "array", "minItems": 1},
    "reviews": {"type": "object"}
  }
}
