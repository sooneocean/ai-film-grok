{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dex/ai-film-grok/longform-production-plan.schema.json",
  "title": "ai-film-grok longform production plan",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "ok",
    "production_mode",
    "aspect_ratio",
    "target_duration_sec",
    "actual_duration_sec",
    "unit_max_duration_sec",
    "approval_policy",
    "approval_gates",
    "workflow_core",
    "packs",
    "source_hashes",
    "units",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "longform-production-plan" },
    "ok": { "const": true },
    "production_mode": { "const": "longform" },
    "aspect_ratio": { "const": "9:16" },
    "target_duration_sec": { "type": "number", "minimum": 480, "maximum": 900 },
    "actual_duration_sec": { "type": "number", "minimum": 480, "maximum": 900 },
    "unit_max_duration_sec": { "type": "number", "exclusiveMinimum": 0, "maximum": 90 },
    "approval_policy": { "const": "three_gates" },
    "approval_gates": {
      "const": ["story_animatic_lock", "pilot_scene", "final_full_watch"]
    },
    "workflow_core": {
      "type": "object",
      "required": ["version", "stages", "evidence_policy"],
      "properties": {
        "version": { "const": 1 },
        "stages": {
          "const": ["story", "editorial", "visual", "performance", "sound", "post", "delivery"]
        },
        "evidence_policy": { "const": "hash-bound-fail-closed" }
      },
      "additionalProperties": false
    },
    "packs": {
      "type": "object",
      "required": ["format", "genre"],
      "properties": {
        "format": { "const": "vertical-longform" },
        "genre": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source_hashes": {
      "type": "object",
      "required": ["graph", "spec", "timeline"],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "act_id",
          "scene_ids",
          "beat_ids",
          "shot_ids",
          "duration_sec",
          "depends_on"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^lf-unit-[0-9]{3}$" },
          "act_id": { "enum": ["act1", "act2", "act3"] },
          "scene_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "beat_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "shot_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "duration_sec": { "type": "number", "exclusiveMinimum": 0, "maximum": 90 },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "approval_gate": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_at": { "type": "string" }
  },
  "additionalProperties": false
}
