# secrets & local runtime — never commit
**/config.env
**/.env
**/.env.*
!**/.env.example
!**/config.env.example

# OS / editor
**/.DS_Store
**/.idea/
**/.vscode/
**/*.swp
**/*~

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.benchmarks/
**/.coverage
**/htmlcov/
**/*.egg-info/
**/.venv/
**/venv/
/.local-runtimes/
**/g2pW/

# Node (if any post tooling lands)
**/node_modules/
**/dist/

# local skill noise
**/backups/
**/receipts/
**/*.log
**/last_suite.log

# film project outputs accidentally copied in
**/out/
**/clips/
**/keyframes/
**/film-spec.json
**/manifest.json
**/timeline.json

# local backup artifacts
**/*.bak
**/*.bak-*
**/*~pre-*

# transient locks & temporary test queues emitted during run
artifacts/**/*.lock
artifacts/lipdub-queue-*

# canary binary media — keep JSON/receipts tracked; media stays local only
artifacts/**/*.mp4
artifacts/**/*.mov
artifacts/**/*.webm
artifacts/**/*.png
artifacts/**/*.jpg
artifacts/**/*.jpeg
artifacts/**/*.webp
artifacts/**/*.wav
artifacts/**/*.mp3
artifacts/**/*.flac

# session / run-continuation tooling artifacts (never commit)
.omo/
.zcode/
coverage.json

# local dev artifacts (should never be committed)
.kilo/
backups-skills/
